{
    "name": "shirahcan/ai-client",
    "description": "The Shirah estate's one door to ai-service: generation, embeddings, streaming, web research, and the assistant harness. Speaks to it over loopback; holds no provider keys of its own, and must never learn how to.",
    "type": "library",
    "license": "proprietary",
    "require": {
        "php": "^8.2",
        "illuminate/support": "^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.8"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "orchestra/testbench": "^9.0|^10.0"
    },
    "autoload": {
        "psr-4": {
            "Shirahcan\\AiClient\\": "src/"
        },
        "files": [
            "src/compat.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Shirahcan\\AiClient\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Shirahcan\\AiClient\\AiClientServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
